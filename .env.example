# ============================================================
# 每日早盘全球股票情报精选 v2.1 - 环境变量模板
# 使用方法：复制本文件为 .env 并填入真实值
# ============================================================

# ---- 企业微信群机器人 Webhook（任选其一填入）----
# 推送选股报告到企业微信群，不填则进入模拟模式（仅打印不推送）
WECHAT_WEBHOOK=
# 兼容别名（任选其一即可，按优先级取第一个非空）
QX_WECOM_WEBHOOK=
WECOM_WEBHOOK=
QYWX_WEBHOOK=

# ---- 选股参数调优 ----
# 选出前N只个股，默认5
TOP_N=5
# 初筛后最多处理多少只（越大越全但越慢，云端建议150-200）
MAX_STOCKS=200
# 最低流通市值（亿元），默认50
MIN_MARKET_CAP=50
# 最高流通市值（亿元），默认1000
MAX_MARKET_CAP=1000
# 最低股票价格（元），默认5
MIN_PRICE=5
# 是否抓取新闻公告（关闭可提速3倍）
ENABLE_NEWS=true
# 综合得分最低阈值（0-100），默认0即不设限
MIN_SCORE_THRESHOLD=0

# ---- 数据源优先级（逗号分隔）----
# plugin: 本地Trae Agent环境的iFinD Skill + TDX MCP（本地Agent可用时首选）
# akshare: 开源免费接口（云端GitHub Actions默认）
# websearch: 公开财经网站爬虫（终极兜底）
DATA_SOURCE_PRIORITY=akshare,websearch

# ---- 接口限速 ----
# 每次请求最小间隔（秒），防止被封控
API_MIN_INTERVAL=1.2
# 每个数据源最多重试次数
API_MAX_RETRIES=2
# 单次请求超时（秒）
API_TIMEOUT=20
